# =========================================================================
# 【通用交付模板】多阶段源码编译 + 纯密文运行时容器构建 (v3.0 旗舰版)
# =========================================================================

# -------------------------------------------------------------------------
# 🔒 【第一阶段：编译构建环境 (Builder) - 保持默认即可】
# -------------------------------------------------------------------------
FROM python:3.11-slim AS builder

WORKDIR /app

# 1. 安装编译工具链与常用数据库 C 头文件 (支持 MySQL 与 PostgreSQL 驱动编译)
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    binutils \
    pkg-config \
    libpq-dev \
    default-libmysqlclient-dev \
    && rm -rf /var/lib/apt/lists/*

# 2. 利用 Docker 缓存层优先安装 Python 依赖库
COPY requirements.txt .
RUN pip install --no-cache-dir setuptools wheel cython -i https://pypi.tuna.tsinghua.edu.cn/simple
RUN pip install --no-cache-dir -r requirements.txt -i https://pypi.tuna.tsinghua.edu.cn/simple

# 3. 拷贝全部项目源码并执行 Cython 原生机器码编译
COPY . .
RUN python build_encrypted.py build_ext --inplace

# 4. 剥离所有编译生成的 .so 二进制动态库中的符号表信息（防反编译与逆向分析）
RUN find . -name "*.so" -exec strip --strip-unneeded {} +

# -------------------------------------------------------------------------
# 🔒 【第二阶段：生产运行环境 (Runtime) - 保持默认即可】
# -------------------------------------------------------------------------
FROM python:3.11-slim AS runtime

WORKDIR /app

# 设置 Python 模块全局搜索根路径（解决 Monorepo/子包导入报错）与标准输出无缓冲
ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1

# 仅安装生产运行所必需的数据库动态链接运行时库
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    libmariadb3 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# 从 Builder 阶段拷贝已预装的第三方库依赖（二进制 wheel）与系统可执行文件
COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# 仅拷贝已完成机器码编译且已物理销毁源码的应用目录
COPY --from=builder /app /app

# -------------------------------------------------------------------------
# 👉 【按需修改 1】：暴露的容器端口（默认 8000）
# -------------------------------------------------------------------------
EXPOSE 8000

# -------------------------------------------------------------------------
# 👉 【必须修改 2】：生产环境启动命令（根据项目框架类型 3 选 1）
# -------------------------------------------------------------------------

# 【选项 A：FastAPI 项目 (推荐 - 子目录结构，如 app/main.py)】
# 包含 prestart.sh 数据迁移自动执行，启动 Uvicorn
# 👉 【必须修改 3】：uvicorn app.main:app根据项目的实际入口文件路径和变量名来修改
CMD ["bash", "-c", "bash scripts/prestart.sh 2>/dev/null || true; python -m uvicorn app.main:app --host 0.0.0.0 --port 8000"]

# 【选项 B：FastAPI 项目 (扁平单文件结构，如根目录下的 main.py)】
# CMD ["python", "-m", "uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]

# 【选项 C：Django 项目 (使用 Gunicorn 启动多进程)】
# CMD ["gunicorn", "wsgi:application", "-b", "0.0.0.0:8000", "-w", "4"]
